# .env.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-string
BASE_URL=http://localhost:8000

# ── Database ──────────────────────────────────────────────────────────────────
# Note: use postgresql+asyncpg:// NOT postgresql:// (asyncpg is the async driver)
DATABASE_URL=postgresql+asyncpg://subpay:subpay@localhost:5432/subpay

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get these from your Paystack dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_WEBHOOK_SECRET=xxx

# ── Notifications ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxx
TERMII_API_KEY=xxx
TWILIO_ACCOUNT_SID=xxx
TWILIO_AUTH_TOKEN=xxx
WHATSAPP_FROM=whatsapp:+234xxxxxxxxxx
